			subtitle: "Large crafting table"
			description: [
				"One of the most important blocks in the entire mod. This is more useful than just a grid. It can craft things within and auto fill slots for crafting. VERY useful."
				""
				""
			]
			dependencies: ["49F2DD4347596082"]
			id: "6D2C7F022DF10FC0"
